# AI Service Configuration
PROJECT_NAME="AI DevOps Assistant - Core AI Service"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security API Key (Inter-service authentication)
AI_SERVICE_API_KEY=devops-ai-secret-key-2026

# Active LLM Provider: "gemini", "openai", or "ollama"
LLM_PROVIDER=gemini

# Google Gemini (Default)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Ollama Local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ChromaDB & Embeddings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=devops_knowledge_base
DOCS_SOURCE_DIRECTORY=./docs-source

# Resilience & Timeouts
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
